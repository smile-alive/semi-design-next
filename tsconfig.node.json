{
    "extends": "./tsconfig.base.json",
    "compilerOptions": {
        "lib": ["esnext"],
        "types": ["node"],
        "composite": true,
        "emitDeclarationOnly": true,
        "outDir": "node_modules/.tmp/tsconfig.node",
        "allowImportingTsExtensions": true,
        "noImplicitAny": true,
        "noImplicitReturns": false,
        "noImplicitThis": true
    },
    "include": [
        "commitlint.config.ts",
        "eslint.config.ts",
        "stylelint.config.ts",
        "vite.config.ts",
        "vite.semi*.ts",
        "lint",
        "packages/**/vite.config.ts",
        "packages/plugins/semi-vite/src",
        "packages/plugins/semi-scss-compile/src",
        "packages/plugins/semi-scss-compile/__tests__",
        "packages/shared/semi-icons-core/src/types.ts",
        "scripts",
        "packages/*/scripts",
        "packages/*/*/scripts",
        "packages/plugins/*/test/run.ts",
        "vitest/packed",
        "vitest/hosts",
        "vitest/*/hosts",
        "vitest/framework.ts",
        "vitest/index.ts",
        "vitest/*/index.ts",
        "vitest/solid/hydration-setup.ts",
        "vitest/solid/hydration-context.ts"
    ]
}

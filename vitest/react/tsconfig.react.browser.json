{
    "extends": "./tsconfig.react.json",
    // the Playwright provider types the CDP session the browser tests use to emulate media and input
    "compilerOptions": { "types": ["node", "vite/client", "@vitest/browser-playwright"] },
    "include": [
        "../browser.setup.ts",
        "../utils/browser.ts",
        "../../packages/semi-*-react/**/__tests__/**/*.browser.test.ts",
        "../../packages/semi-*-react/**/__tests__/**/*.browser.test.tsx",
        "../../packages/semi-ui-react/src/styles.d.ts",
        "../../packages/semi-ai-react/src/styles.d.ts",
        "../../packages/semi-ai-react/src/semi-global.ts",
        "../../packages/semi-icons-react/src/styles.d.ts",
        "../../packages/semi-foundation/src/dom.d.ts"
    ],
    "exclude": ["../../packages/*/node_modules", "../../packages/*/dist"]
}

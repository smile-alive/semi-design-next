{
    "extends": "./tsconfig.react.json",
    // the Playwright provider types the CDP session the browser tests use to emulate media and input
    "compilerOptions": { "types": ["node", "vite/client", "@vitest/browser-playwright"] },
    "include": [
        "../browser.setup.ts",
        "../utils/browser.ts",
        "../../packages/react/*/**/__tests__/**/*.browser.test.ts",
        "../../packages/react/*/**/__tests__/**/*.browser.test.tsx",
        "../../packages/react/ui/src/styles.d.ts",
        "../../packages/react/ai/src/styles.d.ts",
        "../../packages/react/ai/src/utils/semi-global.ts",
        "../../packages/react/icons/src/styles.d.ts",
        "../../packages/shared/foundation/src/dom.d.ts"
    ],
    "exclude": ["../../packages/*/*/node_modules", "../../packages/*/*/dist"]
}

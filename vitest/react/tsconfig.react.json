{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        // vite/client types import.meta.glob, which the demo-rendering tests use
        "types": ["node", "vite/client"],
        "noEmit": true,
        // semi-ui-react's own options: the tests compile the package source they import
        "strict": true,
        "noImplicitAny": false,
        // Tests import the package they test by name; it resolves to source as at runtime (semiSourceAliases), since
        // mixing built declarations with source would make classes with `#` members two incompatible types.
        // The Lottie and JsonViewer tests mock or import dependencies only semi-foundation declares.
        "paths": {
            "@test/*": ["../*"],
            "@fibrae/semi-ui-react": ["../../packages/react/ui/src/index.ts"],
            "@fibrae/semi-ui-react/hooks": ["../../packages/react/ui/src/hooks.ts"],
            "@fibrae/semi-ui-react/tokens": ["../../packages/react/ui/src/tokens.ts"],
            "@fibrae/semi-ui-react/base/*": ["../../packages/react/ui/src/base/*"],
            "@fibrae/semi-ui-react/hooks/*": ["../../packages/react/ui/src/hooks/*"],
            "@fibrae/semi-ui-react/internal/*": ["../../packages/react/ui/src/internal/*"],
            "@fibrae/semi-ui-react/utils/*": ["../../packages/react/ui/src/utils/*"],
            "@fibrae/semi-ui-react/__tests__/*": ["../../packages/react/ui/src/__tests__/*"],
            "@fibrae/semi-ui-react/*": ["../../packages/react/ui/src/components/*"],
            "@fibrae/semi-ai-react": ["../../packages/react/ai/src/index.ts"],
            "@fibrae/semi-ai-react/utils/*": ["../../packages/react/ai/src/utils/*"],
            "@fibrae/semi-ai-react/__tests__/*": ["../../packages/react/ai/src/__tests__/*"],
            "@fibrae/semi-ai-react/*": ["../../packages/react/ai/src/components/*"],
            "@fibrae/semi-foundation/*": ["../../packages/shared/foundation/src/*"],
            "@fibrae/semi-ai-foundation/*": ["../../packages/shared/ai-foundation/src/*"],
            "@fibrae/semi-json-viewer-core": ["../../packages/shared/json-viewer-core/dist/index.d.ts"],
            "lottie-web": ["../../packages/shared/foundation/node_modules/lottie-web"]
        }
    },
    "include": [
        "react.setup.ts",
        "../vitest.setup.ts",
        "../utils/react.ts",
        "../utils/dom/react.ts",
        "../utils/table/react.tsx",
        "../../packages/react/*/**/__tests__/**/*.ts",
        "../../packages/react/*/**/__tests__/**/*.tsx",
        "../../packages/react/ui/src/styles.d.ts",
        "../../packages/react/ai/src/styles.d.ts",
        "../../packages/react/ai/src/utils/semi-global.ts",
        "../../packages/react/icons/src/styles.d.ts",
        "../../packages/shared/foundation/src/dom.d.ts"
    ],
    // Browser tests: their matcher types replace jest-dom's, so tsconfig.react.browser.json checks them.
    "exclude": ["../../packages/**/*.browser.test.*", "../../packages/*/*/node_modules", "../../packages/*/*/dist"]
}

{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "types": ["node", "vite/client"],
        "strict": true,
        "strictNullChecks": true,
        "noEmit": true,
        "jsx": "preserve",
        "jsxImportSource": "vue",
        "paths": {
            "@test/*": ["../*"],
            "@fibrae/semi-ui-vue": ["../../packages/vue/ui/src/index.ts"],
            "@fibrae/semi-ui-vue/composables": ["../../packages/vue/ui/src/composables.ts"],
            "@fibrae/semi-ui-vue/tokens": ["../../packages/vue/ui/src/tokens.ts"],
            "@fibrae/semi-ui-vue/base/*": ["../../packages/vue/ui/src/base/*"],
            "@fibrae/semi-ui-vue/composables/*": ["../../packages/vue/ui/src/composables/*"],
            "@fibrae/semi-ui-vue/internal/*": ["../../packages/vue/ui/src/internal/*"],
            "@fibrae/semi-ui-vue/utils/*": ["../../packages/vue/ui/src/utils/*"],
            "@fibrae/semi-ui-vue/__tests__/*": ["../../packages/vue/ui/src/__tests__/*"],
            "@fibrae/semi-ui-vue/*": ["../../packages/vue/ui/src/components/*"],
            "@fibrae/semi-ai-vue": ["../../packages/vue/ai/src/index.ts"],
            "@fibrae/semi-ai-vue/base/*": ["../../packages/vue/ai/src/base/*"],
            "@fibrae/semi-ai-vue/utils/*": ["../../packages/vue/ai/src/utils/*"],
            "@fibrae/semi-ai-vue/__tests__/*": ["../../packages/vue/ai/src/__tests__/*"],
            "@fibrae/semi-ai-vue/*": ["../../packages/vue/ai/src/components/*"],
            "@fibrae/semi-icons-vue": ["../../packages/vue/icons/src/index.ts"],
            "@fibrae/semi-icons-vue/*": ["../../packages/vue/icons/src/*"],
            "@fibrae/semi-illustrations-vue": ["../../packages/vue/illustrations/src/index.ts"],
            "@fibrae/semi-foundation/*": ["../../packages/shared/foundation/dist/*"],
            "@fibrae/semi-json-viewer-core": ["../../packages/shared/json-viewer-core/dist/index.d.ts"]
        }
    },
    "vueCompilerOptions": { "checkUnknownComponents": true, "strictVModel": true },
    "include": [
        "vue.setup.ts",
        "vue.jsdom.setup.ts",
        "../utils/vue.ts",
        "../../packages/vue/ui/**/__tests__/**/*.ts",
        "../../packages/vue/ui/**/__tests__/**/*.tsx",
        "../../packages/vue/ui/**/__tests__/**/*.vue",
        "../../packages/vue/icons/**/__tests__/**/*.ts",
        "../../packages/vue/ui/src/styles.d.ts",
        "../../packages/vue/ai/**/__tests__/**/*.ts",
        "../../packages/vue/ai/**/__tests__/**/*.tsx",
        "../../packages/vue/ai/**/__tests__/**/*.vue",
        "../../packages/vue/ai/src/styles.d.ts",
        "../../packages/shared/foundation/src/dom.d.ts",
        "../../packages/vue/ai/src/utils/semi-global.ts",
        "../../node_modules/@testing-library/jest-dom/types/vitest.d.ts"
    ],
    "exclude": ["../../packages/*/*/node_modules", "../../packages/*/*/dist", "../../packages/**/*.browser.test.*"]
}

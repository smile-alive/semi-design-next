{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "types": ["node", "vite/client"],
        "strict": true,
        "strictNullChecks": true,
        "noEmit": true,
        "jsx": "preserve",
        "jsxImportSource": "vue",
        "paths": {
            "@test/*": ["../*"],
            "@fibrae/semi-ui-vue": ["../../packages/semi-ui-vue/src/index.ts"],
            "@fibrae/semi-ui-vue/composables": ["../../packages/semi-ui-vue/src/composables.ts"],
            "@fibrae/semi-ui-vue/tokens": ["../../packages/semi-ui-vue/src/tokens.ts"],
            "@fibrae/semi-ui-vue/locale": ["../../packages/semi-ui-vue/src/locale.ts"],
            "@fibrae/semi-ui-vue/base": ["../../packages/semi-ui-vue/src/base/index.ts"],
            "@fibrae/semi-ui-vue/internal": ["../../packages/semi-ui-vue/src/internal/index.ts"],
            "@fibrae/semi-ui-vue/utils": ["../../packages/semi-ui-vue/src/utils/index.ts"],
            "@fibrae/semi-ui-vue/base/*": ["../../packages/semi-ui-vue/src/base/*"],
            "@fibrae/semi-ui-vue/composables/*": ["../../packages/semi-ui-vue/src/composables/*"],
            "@fibrae/semi-ui-vue/internal/*": ["../../packages/semi-ui-vue/src/internal/*"],
            "@fibrae/semi-ui-vue/utils/*": ["../../packages/semi-ui-vue/src/utils/*"],
            "@fibrae/semi-ui-vue/__tests__/*": ["../../packages/semi-ui-vue/src/__tests__/*"],
            "@fibrae/semi-ui-vue/*": ["../../packages/semi-ui-vue/src/components/*"],
            "@fibrae/semi-ai-vue": ["../../packages/semi-ai-vue/src/index.ts"],
            "@fibrae/semi-ai-vue/base/*": ["../../packages/semi-ai-vue/src/base/*"],
            "@fibrae/semi-ai-vue/utils/*": ["../../packages/semi-ai-vue/src/utils/*"],
            "@fibrae/semi-ai-vue/__tests__/*": ["../../packages/semi-ai-vue/src/__tests__/*"],
            "@fibrae/semi-ai-vue/*": ["../../packages/semi-ai-vue/src/components/*"],
            "@fibrae/semi-icons-vue": ["../../packages/semi-icons-vue/src/index.ts"],
            "@fibrae/semi-icons-vue/*": ["../../packages/semi-icons-vue/src/*"],
            "@fibrae/semi-foundation/*": ["../../packages/shared/semi-foundation/dist/*"],
            "@fibrae/semi-json-viewer-core": ["../../packages/shared/semi-json-viewer-core/dist/index.d.ts"]
        }
    },
    "vueCompilerOptions": { "checkUnknownComponents": true, "strictVModel": true },
    "include": [
        "vue.setup.ts",
        "vue.jsdom.setup.ts",
        "../utils/vue.ts",
        "../../packages/semi-ui-vue/**/__tests__/**/*.ts",
        "../../packages/semi-ui-vue/**/__tests__/**/*.tsx",
        "../../packages/semi-ui-vue/**/__tests__/**/*.vue",
        "../../packages/semi-icons-vue/**/__tests__/**/*.ts",
        "../../packages/semi-ui-vue/src/styles.d.ts",
        "../../packages/semi-ai-vue/**/__tests__/**/*.ts",
        "../../packages/semi-ai-vue/**/__tests__/**/*.tsx",
        "../../packages/semi-ai-vue/**/__tests__/**/*.vue",
        "../../packages/semi-ai-vue/src/styles.d.ts",
        "../../packages/shared/semi-foundation/src/dom.d.ts",
        "../../packages/semi-ai-vue/src/utils/semi-global.ts",
        "../../node_modules/@testing-library/jest-dom/types/vitest.d.ts"
    ],
    "exclude": ["../../packages/*/node_modules", "../../packages/*/dist", "../../packages/**/*.browser.test.*"]
}

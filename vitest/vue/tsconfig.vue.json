{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "types": ["node", "vite/client"],
        "strict": true,
        "strictNullChecks": true,
        "noEmit": true,
        "jsx": "preserve",
        "jsxImportSource": "vue",
        "paths": {
            "@test/*": ["../*"],
            "@fibrae/semi-ui-vue": ["../../packages/semi-ui-vue/src/index.ts"],
            "@fibrae/semi-ui-vue/*": ["../../packages/semi-ui-vue/src/*"],
            "@fibrae/semi-ai-vue": ["../../packages/semi-ai-vue/src/index.ts"],
            "@fibrae/semi-ai-vue/*": ["../../packages/semi-ai-vue/src/*"],
            "@fibrae/semi-icons-vue": ["../../packages/semi-icons-vue/src/index.ts"],
            "@fibrae/semi-icons-vue/*": ["../../packages/semi-icons-vue/src/*"],
            "@fibrae/semi-illustrations-vue": ["../../packages/semi-illustrations-vue/src/index.ts"],
            "@fibrae/semi-foundation/*": ["../../packages/semi-foundation/dist/*"],
            "@fibrae/semi-json-viewer-core": ["../../packages/semi-json-viewer-core/dist/index.d.ts"]
        }
    },
    "vueCompilerOptions": { "checkUnknownComponents": true, "strictVModel": true },
    "include": [
        "vue.setup.ts",
        "vue.jsdom.setup.ts",
        "../utils/vue.ts",
        "../../packages/semi-ui-vue/**/__tests__/**/*.ts",
        "../../packages/semi-ui-vue/**/__tests__/**/*.tsx",
        "../../packages/semi-ui-vue/**/__tests__/**/*.vue",
        "../../packages/semi-icons-vue/**/__tests__/**/*.ts",
        "../../packages/semi-ui-vue/src/styles.d.ts",
        "../../packages/semi-ai-vue/**/__tests__/**/*.ts",
        "../../packages/semi-ai-vue/**/__tests__/**/*.tsx",
        "../../packages/semi-ai-vue/**/__tests__/**/*.vue",
        "../../packages/semi-ai-vue/src/styles.d.ts",
        "../../packages/semi-foundation/src/dom.d.ts",
        "../../packages/semi-ai-vue/src/semi-global.ts",
        "../../node_modules/@testing-library/jest-dom/types/vitest.d.ts"
    ],
    "exclude": ["../../packages/*/node_modules", "../../packages/*/dist", "../../packages/**/*.browser.test.*"]
}

{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "types": ["node", "vite/client"],
        "strict": true,
        "strictNullChecks": true,
        "noEmit": true,
        "jsx": "preserve",
        "jsxImportSource": "solid-js",
        "paths": {
            "@test/*": ["../*"],
            "@fibrae/semi-ui-solid": ["../../packages/semi-ui-solid/src/index.ts"],
            "@fibrae/semi-ui-solid/primitives": ["../../packages/semi-ui-solid/src/primitives.ts"],
            "@fibrae/semi-ui-solid/tokens": ["../../packages/semi-ui-solid/src/tokens.ts"],
            "@fibrae/semi-ui-solid/base/*": ["../../packages/semi-ui-solid/src/base/*"],
            "@fibrae/semi-ui-solid/primitives/*": ["../../packages/semi-ui-solid/src/primitives/*"],
            "@fibrae/semi-ui-solid/internal/*": ["../../packages/semi-ui-solid/src/internal/*"],
            "@fibrae/semi-ui-solid/utils/*": ["../../packages/semi-ui-solid/src/utils/*"],
            "@fibrae/semi-ui-solid/__tests__/*": ["../../packages/semi-ui-solid/src/__tests__/*"],
            "@fibrae/semi-ui-solid/*": ["../../packages/semi-ui-solid/src/components/*"],
            "@fibrae/semi-ai-solid": ["../../packages/semi-ai-solid/src/index.ts"],
            "@fibrae/semi-ai-solid/*": ["../../packages/semi-ai-solid/src/*"],
            "@fibrae/semi-icons-solid": ["../../packages/semi-icons-solid/src/index.ts"],
            "@fibrae/semi-icons-solid/*": ["../../packages/semi-icons-solid/src/*"],
            "@fibrae/semi-illustrations-solid": ["../../packages/semi-illustrations-solid/src/index.ts"],
            "@fibrae/semi-foundation/*": ["../../packages/semi-foundation/dist/*"],
            "@fibrae/semi-json-viewer-core": ["../../packages/semi-json-viewer-core/dist/index.d.ts"]
        }
    },
    "include": [
        "solid.setup.ts",
        "hydration.server.solid.tsx",
        "../../packages/semi-*-solid/**/__tests__/**/*.ts",
        "../../packages/semi-*-solid/**/__tests__/**/*.tsx",
        "../../packages/semi-ai-solid/src/semi-global.ts",
        "../../packages/semi-foundation/src/dom.d.ts",
        "../../node_modules/@testing-library/jest-dom/types/vitest.d.ts"
    ],
    "exclude": ["../../packages/*/node_modules", "../../packages/*/dist", "../../packages/**/*.browser.test.*"]
}

{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "types": ["node", "vite/client"],
        "strict": true,
        "strictNullChecks": true,
        "noEmit": true,
        "jsx": "preserve",
        "jsxImportSource": "solid-js",
        "paths": {
            "@test/*": ["../*"],
            "@fibrae/semi-ui-solid": ["../../packages/solid/ui/src/index.ts"],
            "@fibrae/semi-ui-solid/primitives": ["../../packages/solid/ui/src/primitives.ts"],
            "@fibrae/semi-ui-solid/tokens": ["../../packages/solid/ui/src/tokens.ts"],
            "@fibrae/semi-ui-solid/base/*": ["../../packages/solid/ui/src/base/*"],
            "@fibrae/semi-ui-solid/primitives/*": ["../../packages/solid/ui/src/primitives/*"],
            "@fibrae/semi-ui-solid/internal/*": ["../../packages/solid/ui/src/internal/*"],
            "@fibrae/semi-ui-solid/utils/*": ["../../packages/solid/ui/src/utils/*"],
            "@fibrae/semi-ui-solid/__tests__/*": ["../../packages/solid/ui/src/__tests__/*"],
            "@fibrae/semi-ui-solid/*": ["../../packages/solid/ui/src/components/*"],
            "@fibrae/semi-ai-solid": ["../../packages/solid/ai/src/index.ts"],
            "@fibrae/semi-ai-solid/utils/*": ["../../packages/solid/ai/src/utils/*"],
            "@fibrae/semi-ai-solid/__tests__/*": ["../../packages/solid/ai/src/__tests__/*"],
            "@fibrae/semi-ai-solid/*": ["../../packages/solid/ai/src/components/*"],
            "@fibrae/semi-icons-solid": ["../../packages/solid/icons/src/index.ts"],
            "@fibrae/semi-icons-solid/*": ["../../packages/solid/icons/src/*"],
            "@fibrae/semi-illustrations-solid": ["../../packages/solid/illustrations/src/index.ts"],
            "@fibrae/semi-foundation/*": ["../../packages/shared/foundation/dist/*"],
            "@fibrae/semi-json-viewer-core": ["../../packages/shared/json-viewer-core/dist/index.d.ts"]
        }
    },
    "include": [
        "solid.setup.ts",
        "hydration.server.solid.tsx",
        "../../packages/solid/*/**/__tests__/**/*.ts",
        "../../packages/solid/*/**/__tests__/**/*.tsx",
        "../../packages/solid/ai/src/utils/semi-global.ts",
        "../../packages/shared/foundation/src/dom.d.ts",
        "../../node_modules/@testing-library/jest-dom/types/vitest.d.ts"
    ],
    "exclude": ["../../packages/*/*/node_modules", "../../packages/*/*/dist", "../../packages/**/*.browser.test.*"]
}

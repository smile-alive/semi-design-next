{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "types": ["node", "vite/client"],
        "strict": true,
        "strictNullChecks": true,
        "noEmit": true,
        "verbatimModuleSyntax": true,
        "paths": {
            "@test/*": ["../*"],
            "@fibrae/semi-ui-svelte": ["../../packages/svelte/ui/src/index.ts"],
            "@fibrae/semi-ui-svelte/hooks": ["../../packages/svelte/ui/src/hooks.ts"],
            "@fibrae/semi-ui-svelte/tokens": ["../../packages/svelte/ui/src/tokens.ts"],
            "@fibrae/semi-ui-svelte/base/*": ["../../packages/svelte/ui/src/base/*"],
            "@fibrae/semi-ui-svelte/hooks/*": ["../../packages/svelte/ui/src/hooks/*"],
            "@fibrae/semi-ui-svelte/internal/*": ["../../packages/svelte/ui/src/internal/*"],
            "@fibrae/semi-ui-svelte/utils/*": ["../../packages/svelte/ui/src/utils/*"],
            "@fibrae/semi-ui-svelte/__tests__/*": ["../../packages/svelte/ui/src/__tests__/*"],
            "@fibrae/semi-ui-svelte/*": ["../../packages/svelte/ui/src/components/*"],
            "@fibrae/semi-icons-svelte": ["../../packages/svelte/icons/src/index.ts"],
            "@fibrae/semi-icons-svelte/*": ["../../packages/svelte/icons/src/*"],
            "@fibrae/semi-illustrations-svelte": ["../../packages/svelte/illustrations/src/index.ts"],
            "@fibrae/semi-illustrations-svelte/*": ["../../packages/svelte/illustrations/src/*"],
            "@fibrae/semi-foundation/*": ["../../packages/shared/foundation/dist/*"],
            "@fibrae/semi-json-viewer-core": ["../../packages/shared/json-viewer-core/dist/index.d.ts"]
        }
    },
    "include": ["svelte.setup.ts", "../utils/host-contract.ts", "../../packages/svelte/*/**/__tests__/**/*.ts", "../../packages/svelte/*/**/__tests__/**/*.svelte", "../../packages/svelte/*/src/*.d.ts", "../../packages/shared/foundation/src/dom.d.ts", "../../node_modules/@testing-library/jest-dom/types/vitest.d.ts"],
    "exclude": ["../../packages/*/*/node_modules", "../../packages/*/*/dist", "../../packages/**/*.browser.test.*"]
}

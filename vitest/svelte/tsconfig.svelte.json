{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "types": ["node", "vite/client"],
        "strict": true,
        "strictNullChecks": true,
        "noEmit": true,
        "verbatimModuleSyntax": true,
        "paths": {
            "@test/*": ["../*"],
            "@fibrae/semi-ui-svelte": ["../../packages/semi-ui-svelte/src/index.ts"],
            "@fibrae/semi-ui-svelte/hooks": ["../../packages/semi-ui-svelte/src/hooks.ts"],
            "@fibrae/semi-ui-svelte/tokens": ["../../packages/semi-ui-svelte/src/tokens.ts"],
            "@fibrae/semi-ui-svelte/locale": ["../../packages/semi-ui-svelte/src/locale.ts"],
            "@fibrae/semi-ui-svelte/base": ["../../packages/semi-ui-svelte/src/base/index.ts"],
            "@fibrae/semi-ui-svelte/internal": ["../../packages/semi-ui-svelte/src/internal/index.ts"],
            "@fibrae/semi-ui-svelte/utils": ["../../packages/semi-ui-svelte/src/utils/index.ts"],
            "@fibrae/semi-ui-svelte/base/*": ["../../packages/semi-ui-svelte/src/base/*"],
            "@fibrae/semi-ui-svelte/hooks/*": ["../../packages/semi-ui-svelte/src/hooks/*"],
            "@fibrae/semi-ui-svelte/internal/*": ["../../packages/semi-ui-svelte/src/internal/*"],
            "@fibrae/semi-ui-svelte/utils/*": ["../../packages/semi-ui-svelte/src/utils/*"],
            "@fibrae/semi-ui-svelte/__tests__/*": ["../../packages/semi-ui-svelte/src/__tests__/*"],
            "@fibrae/semi-ui-svelte/*": ["../../packages/semi-ui-svelte/src/components/*"],
            "@fibrae/semi-icons-svelte": ["../../packages/semi-icons-svelte/src/index.ts"],
            "@fibrae/semi-icons-svelte/*": ["../../packages/semi-icons-svelte/src/*"],
            "@fibrae/semi-foundation/*": ["../../packages/shared/semi-foundation/dist/*"],
            "@fibrae/semi-json-viewer-core": ["../../packages/shared/semi-json-viewer-core/dist/index.d.ts"]
        }
    },
    "include": [
        "svelte.setup.ts",
        "../utils/host-contract.ts",
        "../../packages/semi-*-svelte/**/__tests__/**/*.ts",
        "../../packages/semi-*-svelte/**/__tests__/**/*.svelte",
        "../../packages/semi-*-svelte/src/*.d.ts",
        "../../packages/shared/semi-foundation/src/dom.d.ts",
        "../../node_modules/@testing-library/jest-dom/types/vitest.d.ts"
    ],
    "exclude": ["../../packages/*/node_modules", "../../packages/*/dist", "../../packages/**/*.browser.test.*", "../../packages/**/__tests__/**/*-browser-utils.ts"]
}

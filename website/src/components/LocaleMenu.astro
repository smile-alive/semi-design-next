---
import { IconLanguage, IconTick } from '@fibrae/semi-icons-react';
import { Button } from '@fibrae/semi-ui-react';
import { languageLabels, translate } from '#/i18n';
import { locales, type Locale } from '#/lib/docs';

interface Props {
    locale: Locale;
    hrefs: Record<Locale, string>;
}

const { locale, hrefs } = Astro.props;
const t = translate(locale);
---

<Button className="site-wide-only" theme="borderless" type="tertiary" size="large" popoverTarget="locale-menu" aria-label={t('nav_language')}>
    <IconLanguage slot="icon" size="extra-large" />
</Button>
<div class="locale-menu" id="locale-menu" popover>
    {
        locales.map((l) => (
            <a class="locale-menu-item" href={hrefs[l]} hreflang={l} lang={l} aria-current={l === locale ? 'page' : undefined}>
                <IconTick className="locale-menu-tick" />
                {languageLabels[l]}
            </a>
        ))
    }
</div>

<style>
    /* Mirrors Semi Dropdown; the header is fixed with the button at the far right, so position by viewport */
    .locale-menu {
        inset: 46px var(--semi-spacing-loose) auto auto;
        padding: var(--semi-spacing-extra-tight) 0;
        margin: 0;
        color: var(--semi-color-text-0);
        background: var(--semi-color-bg-3);
        border: 0;
        border-radius: var(--semi-border-radius-medium);
        box-shadow: var(--semi-shadow-elevated);
    }

    .locale-menu-item {
        display: flex;
        align-items: center;
        padding: var(--semi-spacing-tight) var(--semi-spacing-base) var(--semi-spacing-tight) var(--semi-spacing-base-tight);
        color: var(--semi-color-text-0);
        text-decoration: none;
    }

    .locale-menu-item:is(:hover, :focus-visible) {
        outline: none;
        background-color: var(--semi-color-fill-0);
    }

    .locale-menu-item[aria-current='page'] {
        font-weight: var(--semi-font-weight-bold);
    }

    /* The check icon comes from a React component, so it has no scope marker */
    .locale-menu-item :global(.locale-menu-tick) {
        margin-right: 9px;
        font-size: var(--semi-font-size-small);
    }

    .locale-menu-item:not([aria-current='page']) :global(.locale-menu-tick) {
        color: transparent;
    }
</style>

<script is:inline>
    // In <head>, before first paint, to avoid a light flash; system default if unset; reads throw with storage disabled
    let stored = null;
    try {
        stored = localStorage.getItem('semi-theme');
    } catch {}
    if (stored ? stored === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches) {
        document.documentElement.setAttribute('theme-mode', 'dark');
    }
</script>

---
import { IconChevronDown } from '@fibrae/semi-icons-react';
import { Tag } from '@fibrae/semi-ui-react';
import { translate } from '#/i18n';
import type { Framework, Locale } from '#/lib/docs';

interface Props {
    locale: Locale;
    framework: Framework;
    groups: { key: string; label: string; items: { href: string; title: string; icon?: string; showNew?: boolean }[] }[];
    current: string;
}

const { locale, framework, groups, current } = Astro.props;
---

<aside class="site-sidebar" id="side-nav" aria-label={translate(locale)('nav_docs')} popover>
    <div class="side-nav" transition:persist={`side-nav-${locale}-${framework}`}>
        {
            groups.map((group) => (
                <details class="side-nav-group" open>
                    <summary class="side-nav-title">
                        {group.label}
                        <IconChevronDown className="side-nav-arrow" />
                    </summary>
                    <ul class="side-nav-list">
                        {group.items.map((item) => (
                            <li>
                                <a class="side-nav-item" href={item.href} aria-current={item.href === current ? 'page' : undefined}>
                                    {item.icon && <img src={item.icon} alt="" width="24" height="24" />}
                                    {/* div, not span: Tag renders a div */}
                                    <div class="side-nav-text">
                                        {item.title}
                                        {item.showNew && (
                                            <Tag className="side-nav-new" size="small" color="purple" type="light">
                                                New
                                            </Tag>
                                        )}
                                    </div>
                                </a>
                            </li>
                        ))}
                    </ul>
                </details>
            ))
        }
    </div>
</aside>
<script is:inline data-astro-rerun>
    // Centers the current page on first appearance without scrolling the window. Reruns per navigation (the client
    // router skips identical inline scripts) since a locale change swaps the sidebar; a marker skips centered ones
    {
        const nav = document.querySelector('.side-nav');
        if (nav && !nav.hasAttribute('data-centered')) {
            nav.setAttribute('data-centered', '');
            const current = nav.querySelector('[aria-current="page"]');
            if (current) {
                nav.scrollTop +=
                    current.getBoundingClientRect().top - nav.getBoundingClientRect().top - nav.clientHeight / 2;
            }
        }
    }
</script>

<script>
    // Non-modal, so Tab could walk behind the open drawer: close it when focus leaves, as APG's disclosure navigation
    // does. Not for the toggle: closing on its mousedown would make its click reopen the drawer.
    document.addEventListener('focusout', (event) => {
        const drawer = document.querySelector<HTMLElement>('#side-nav:popover-open');
        const next = event.relatedTarget;
        if (drawer?.contains(event.target as Node) && next instanceof Element && !drawer.contains(next) && !next.closest('#nav-toggle')) {
            drawer.hidePopover();
        }
    });

    // Moving the node into the new body shifts its scroll (62px on first navigation): save and restore it, then
    // scroll the minimum if the current item is hidden
    let sideNavScroll = 0;
    let sideNavCurrent: string | null = null;
    document.addEventListener('astro:before-swap', (event) => {
        sideNavScroll = document.querySelector('.side-nav')?.scrollTop ?? 0;
        sideNavCurrent = event.newDocument.querySelector('.side-nav [aria-current="page"]')?.getAttribute('href') ?? null;
    });
    document.addEventListener('astro:after-swap', () => {
        // Unmarked means a sidebar swapped in by a locale change; its own inline script centers it
        const nav = document.querySelector<HTMLElement>('.side-nav[data-centered]');
        if (!nav) return;
        nav.scrollTop = sideNavScroll;
        let current: HTMLAnchorElement | undefined;
        for (const link of nav.querySelectorAll('a')) {
            if (link.getAttribute('href') === sideNavCurrent) {
                link.setAttribute('aria-current', 'page');
                current = link;
            } else {
                link.removeAttribute('aria-current');
            }
        }
        if (!current) return;
        const item = current.getBoundingClientRect();
        const view = nav.getBoundingClientRect();
        if (item.top < view.top) nav.scrollTop -= view.top - item.top;
        else if (item.bottom > view.bottom) nav.scrollTop += item.bottom - view.bottom;
    });
</script>

<style lang="scss">
    @use '../styles/breakpoints' as *;

    /* display and the box properties override the popover UA styles. A closed drawer keeps its box rather than
       display: none, because the scripts above scroll the current item into view while it is closed. */
    .site-sidebar {
        position: fixed;
        inset: var(--site-header-height) auto 0 0;
        z-index: 90;
        box-sizing: border-box;
        display: block;
        width: var(--site-sidebar-width);
        height: auto;
        padding: 0;
        margin: 0;
        overflow: visible;
        color: inherit;
        background: var(--semi-color-bg-0);
        border: 0;
    }

    /* Mirrors Semi's vertical Navigation so the shell loads no React or Semi components; rows are 24px for doc icons */
    .side-nav {
        box-sizing: border-box;
        height: 100%;
        padding: var(--semi-spacing-base-tight) 0 0 var(--semi-spacing-tight);
        overflow-y: auto;
        line-height: 24px;
        background: var(--semi-color-nav-bg);
        border-right: 1px solid var(--semi-color-border);
    }

    .side-nav-group {
        margin-bottom: var(--semi-spacing-tight);
    }

    .side-nav-list {
        padding: 0;
        margin: 0;
        list-style: none;
    }

    /* Semi items are 36px tall; the 24px content exceeds the padding room by 4px */
    :is(.side-nav-title, .side-nav-item) {
        box-sizing: border-box;
        display: flex;
        align-items: center;
        height: 36px;
        padding: var(--semi-spacing-tight) var(--semi-spacing-base-tight);
        color: var(--semi-color-text-0);
        border-radius: var(--semi-border-radius-small);
    }

    .side-nav-title {
        margin-bottom: var(--semi-spacing-tight);
        font-weight: var(--semi-font-weight-bold);
        cursor: pointer;
        list-style: none;
    }

    .side-nav-title::-webkit-details-marker {
        display: none;
    }

    /* The arrow comes from a React component, so it has no scope marker */
    .side-nav-title :global(.side-nav-arrow) {
        margin-left: auto;
        color: var(--semi-color-text-2);
    }

    .side-nav-group[open] > .side-nav-title :global(.side-nav-arrow) {
        transform: rotate(180deg);
    }

    .side-nav-item {
        margin-bottom: var(--semi-spacing-tight);
        text-decoration: none;
    }

    .side-nav-item img {
        flex-shrink: 0;
        margin-right: var(--semi-spacing-base-tight);
    }

    /* No ellipsis: overflow past the sidebar width is clipped */
    .side-nav-text {
        overflow: hidden;
        white-space: nowrap;
    }

    .side-nav-item[aria-current='page'] {
        background-color: var(--semi-color-primary-light-default);
    }

    :is(.side-nav-title, .side-nav-item):hover {
        background-color: var(--semi-color-fill-0);
    }

    :is(.side-nav-title, .side-nav-item):active {
        background-color: var(--semi-color-fill-1);
    }

    :is(.side-nav-title, .side-nav-item):focus-visible {
        outline-offset: -2px;
    }

    /* Tag is rendered by React, so it has no scope marker */
    :global(.side-nav-new) {
        margin-inline-start: var(--semi-spacing-extra-tight);
    }

    @media (max-width: $sidebar-drawer) {
        .site-sidebar:not(:popover-open) {
            visibility: hidden;
            transform: translateX(-100%);
        }
    }

    @media (prefers-reduced-motion: no-preference) {
        .side-nav-title :global(.side-nav-arrow) {
            transition: transform 0.2s ease-in-out;
        }
    }

    @media (max-width: $sidebar-drawer) and (prefers-reduced-motion: no-preference) {
        .site-sidebar {
            transition:
                transform 0.2s ease-in-out,
                visibility 0.2s;
        }
    }
</style>

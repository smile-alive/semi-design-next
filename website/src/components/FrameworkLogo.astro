---
import type { Framework } from '#/lib/frameworks';

interface Props {
    framework: Framework;
    class?: string;
}

const { framework, class: className } = Astro.props;
---

<img class={className} src={`/assets/frameworks/${framework}.svg`} alt="" />

<style>
    /* The marks are not square, and callers give the img a square box */
    img {
        object-fit: contain;
    }
</style>

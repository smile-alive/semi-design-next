---
interface Props {
    detail: string;
}

// Type strings escape with backslashes
const detail = Astro.props.detail.replaceAll('\\', '');
// The frontmatter runs once per instance, so the count lives on the per-page locals
const id = `api-type-${(Astro.locals.apiTypeCount = (Astro.locals.apiTypeCount ?? 0) + 1)}`;
---

<span class="api-type" tabindex="0" aria-describedby={id}><code><slot /></code><span class="api-type-detail" id={id} role="tooltip">{detail}</span></span>

<script>
    import { computePosition, flip, offset, shift } from '@floating-ui/dom';

    function placeShownDetails() {
        document.querySelectorAll('.api-type:is(:hover, :focus)').forEach(async (trigger) => {
            const detail = trigger.querySelector<HTMLElement>('.api-type-detail') as HTMLElement;
            const { x, y } = await computePosition(trigger, detail, { strategy: 'fixed', placement: 'bottom-start', middleware: [offset(4), flip(), shift({ padding: 8 })] });
            detail.style.left = `${x}px`;
            detail.style.top = `${y}px`;
        });
    }

    document.addEventListener('mouseover', placeShownDetails);
    document.addEventListener('focusin', placeShownDetails);
    window.addEventListener('scroll', placeShownDetails, { capture: true, passive: true });
    window.addEventListener('resize', placeShownDetails);
</script>

<style>
    .api-type {
        cursor: help;
    }

    .api-type code {
        color: var(--semi-color-warning-active);
        text-decoration: underline dotted;
        background: var(--semi-color-warning-light-default);
    }

    /* Fixed, because the scrolling table wrapper clips an absolute detail on every side */
    .api-type-detail {
        position: fixed;
        top: 0;
        left: 0;
        z-index: 20;
        width: max-content;
        max-width: min(650px, calc(100vw - 16px));
        padding: var(--semi-spacing-tight) var(--semi-spacing-base-tight);
        font-family: var(--site-mono);
        font-size: 13px;
        color: var(--semi-color-text-0);
        word-break: break-word;
        white-space: pre-wrap;
        background: var(--semi-color-bg-3);
        border-radius: var(--semi-border-radius-medium);
        box-shadow: var(--semi-shadow-elevated);
    }

    /* Visually hidden; screen readers still get the full type through aria-describedby */
    .api-type:not(:hover, :focus) .api-type-detail {
        width: 1px;
        height: 1px;
        padding: 0;
        overflow: hidden;
        white-space: nowrap;
        clip-path: inset(50%);
    }
</style>

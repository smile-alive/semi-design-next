---
import { IconMoon, IconSun } from '@fibrae/semi-icons-react';
import { Button } from '@fibrae/semi-ui-react';
import { translate } from '#/i18n';
import type { Locale } from '#/lib/docs';

interface Props {
    locale: Locale;
}

const t = translate(Astro.props.locale);
---

<Button className="theme-toggle site-wide-only" data-theme-toggle theme="borderless" type="tertiary" size="large" aria-label={t('nav_theme')} aria-pressed="false">
    <Fragment slot="icon">
        <IconMoon className="theme-toggle-light" size="extra-large" />
        <IconSun className="theme-toggle-dark" size="extra-large" />
    </Fragment>
</Button>

<script>
    import { getThemeMode, setThemeMode, subscribeThemeMode } from '@fibrae/semi-foundation/utils/theme-mode';

    // html[theme-mode] is the single source: the button and dark-mode demos only change it; sync the button and persist
    const syncThemeToggle = () => {
        const dark = getThemeMode() === 'dark';
        // MoreMenu carries a second toggle for narrow screens
        for (const toggle of document.querySelectorAll('[data-theme-toggle]')) toggle.setAttribute('aria-pressed', String(dark));
        return dark;
    };
    // <html> survives client navigation, so one subscription covers every page
    subscribeThemeMode(() => {
        const dark = syncThemeToggle();
        try {
            localStorage.setItem('semi-theme', dark ? 'dark' : 'light');
        } catch {
            // With storage disabled the choice lasts for this page only
        }
    });

    // The header is replaced on every navigation, so clicks delegate to document
    document.addEventListener('click', (event) => {
        if (!(event.target as Element).closest('[data-theme-toggle]')) return;
        setThemeMode(getThemeMode() === 'dark' ? 'light' : 'dark');
    });

    // the swap copies the new page's <html> attributes over the current ones; carry dark mode over before paint (the
    // inline theme script in <head> does not rerun)
    document.addEventListener('astro:before-swap', (event) => {
        const mode = document.documentElement.getAttribute('theme-mode');
        if (mode) event.newDocument.documentElement.setAttribute('theme-mode', mode);
    });

    document.addEventListener('astro:page-load', syncThemeToggle);
</script>

<style>
    /* Icons come from React components, so they have no scope marker */
    .theme-toggle :global(.theme-toggle-dark),
    :global([theme-mode='dark']) .theme-toggle :global(.theme-toggle-light) {
        display: none;
    }

    :global([theme-mode='dark']) .theme-toggle :global(.theme-toggle-dark) {
        display: inline-block;
    }
</style>

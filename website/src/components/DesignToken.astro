---
import { Table } from '@fibrae/semi-ui-react';
import { translate } from '#/i18n';
import { asLocale } from '#/lib/docs';
import { scssStatements } from '#/lib/scss';

const scssFiles = import.meta.glob<string>(
    [
        '@fibrae/semi-foundation/*/{variables,animation}.scss',
        '@fibrae/semi-ai-foundation/*/{variables,animation}.scss',
    ],
    { query: '?raw', import: 'default', eager: true }
);

interface Props {
    // Defaults to the page slug; set it when the doc page and foundation directory differ
    component?: string;
}

const component = Astro.props.component ?? Astro.params.page ?? '';
const isComment = (line: string) => line.startsWith('//') || line.startsWith('/*');

const tokens = Object.entries(scssFiles)
    .filter(([file]) => file.split('/').at(-2) === component)
    .flatMap(([, raw]) =>
        scssStatements(raw)
            .filter((line) => line.startsWith('$') && !isComment(line))
            .map((line) => {
                const [key, value, comment] = line
                    .split(/:|\/\/|\/\*/)
                    .map((part) => part.trim())
                    .filter(Boolean);
                return {
                    key,
                    value: value?.replace(/;$/, ''),
                    comment: comment?.replace('ignore-semi-css-trans', '').trim(),
                };
            })
    );

if (!tokens.length) {
    throw new Error(`<DesignToken>: no tokens found for "${component}" in packages/semi-foundation or packages/semi-ai-foundation`);
}

const t = translate(asLocale(Astro.currentLocale));
---

<!-- No client: directive, so the table renders to static HTML and no React reaches the browser -->
<Table
    className="design-token"
    title={t('token_note')}
    columns={[
        { title: t('token_variable'), dataIndex: 'key' },
        { title: t('token_default'), dataIndex: 'value' },
        { title: t('token_usage'), dataIndex: 'comment' },
    ]}
    dataSource={tokens}
    pagination={false}
/>

<style>
    :global(.design-token) {
        margin-bottom: 24px;
    }

    :global(.design-token td) {
        overflow-wrap: anywhere;
    }

    :global(.design-token td:first-child) {
        font-weight: 600;
    }
</style>

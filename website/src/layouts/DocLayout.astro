---
import type { MarkdownHeading } from 'astro';
import { ClientRouter } from 'astro:transitions';
import '#/styles/reset.css';
import '@fibrae/semi-foundation/base/tokens.scss';
import '#/styles/doc-demo.scss';
import '#/styles/site.scss';
import PrevNext from '#/components/PrevNext.astro';
import SeoHead from '#/components/SeoHead.astro';
import SideNav from '#/components/SideNav.astro';
import SiteHeader from '#/components/SiteHeader.astro';
import ThemeScript from '#/components/ThemeScript.astro';
import Toc from '#/components/Toc.astro';
import { translate } from '#/i18n';
import {
    categoryLabel,
    docIconUrl,
    docUrl,
    docFrameworks,
    getDocs,
    getSidebar,
    locales,
    parseDocId,
    type Doc,
    type Framework,
    type Locale,
} from '#/lib/docs';
import { frameworkLabels } from '#/lib/frameworks';

interface Props {
    doc: Doc;
    headings: MarkdownHeading[];
    framework: Framework;
}

const { doc, headings, framework } = Astro.props;
const { category, page, locale } = parseDocId(doc.id);
const t = translate(locale);
const localeHrefs = Object.fromEntries(locales.map((l) => [l, docUrl(l, framework, category, page)])) as Record<Locale, string>;
const frameworkHrefs = Object.fromEntries(docFrameworks(doc).map((f) => [f, docUrl(locale, f, category, page)]));

const hrefOf = (d: Doc) => {
    const target = parseDocId(d.id);
    return docUrl(locale, framework, target.category, target.page);
};

const sidebar = (await getSidebar(locale, framework)).filter((group) => group.items.length > 0);
const navGroups = sidebar.map((group) => ({
    key: group.key,
    label: group.label,
    items: group.items.map((item) => ({
        href: hrefOf(item),
        title: item.data.title,
        icon: docIconUrl(item.data.icon),
        showNew: item.data.showNew,
    })),
}));
const flat = sidebar.flatMap((group) => group.items);
const index = flat.findIndex((d) => d.id === doc.id);
const linkOf = (d?: Doc) =>
    d && {
        href: hrefOf(d),
        path: `${categoryLabel(locale, parseDocId(d.id).category)} / ${d.data.title}`,
        title: d.data.title,
        icon: docIconUrl(d.data.icon),
    };

const { title, brief } = doc.data;
const breadcrumb = locale === 'zh-CN' ? categoryLabel(locale, category) : `${categoryLabel(locale, category)} · ${title}`;

// Each framework has its own URL for the same prose, so the framework name keeps titles and descriptions distinct.
// Chinese readers also search components by English name, which the zh-CN title alone would miss
const englishTitle = (await getDocs()).find((d) => d.id === `${category}/${page}/index.en-US`)?.data.title ?? title;
const frameworkLabel = frameworkLabels[framework];
const seoTitle = `${title.includes(englishTitle) ? title : `${title} ${englishTitle}`} - ${frameworkLabel} - Semi Design Next`;
const seoDescription = locale === 'zh-CN' ? `Semi Design Next ${frameworkLabel}：${brief}` : `Semi Design Next for ${frameworkLabel}: ${brief}`;
---

<!doctype html>
<html lang={locale} transition:animate="none">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <ClientRouter />
        <SeoHead title={seoTitle} description={seoDescription} locale={locale} hrefs={localeHrefs} type="article" />
    </head>
    <body>
        <a class="skip-link" href="#main">{t('nav_skip')}</a>
        <ThemeScript />
        <SiteHeader locale={locale} framework={framework} localeHrefs={localeHrefs} frameworkHrefs={frameworkHrefs} />
        <SideNav locale={locale} framework={framework} groups={navGroups} current={hrefOf(doc)} />
        <main class="site-main" id="main">
            <div class="article-wrapper">
                <header class="doc-header">
                    <div class="doc-breadcrumb">{breadcrumb}</div>
                    <h1>{title}</h1>
                    <p class="doc-brief">{brief}</p>
                </header>
                <article class="doc">
                    <slot />
                </article>
                <PrevNext label={t('nav_prev_next')} prev={linkOf(flat[index - 1])} next={linkOf(flat[index + 1])} />
            </div>
        </main>
        <Toc locale={locale} headings={headings} />
        <script>
            import { setupCodeHighlight } from '#/lib/code-highlight';
            import { setupScrollAnchor } from '#/lib/scroll-anchor';
            import { setupSingletonCarry } from '#/lib/singleton-carry';

            setupCodeHighlight();
            setupSingletonCarry();
            setupScrollAnchor();
        </script>
    </body>
</html>

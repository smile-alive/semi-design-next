{
    "extends": "./tsconfig.json",
    "include": ["content/**/*.vue", "src/components/landing/samples/*.vue"],
    "exclude": ["dist"],
    "compilerOptions": {
        "jsx": "preserve",
        "jsxImportSource": "vue",
        "noEmit": true,
        "noUnusedLocals": true,
        "strict": true,
        "strictNullChecks": true
    },
    "vueCompilerOptions": { "checkUnknownComponents": true, "strictVModel": true }
}

{
    "extends": "./tsconfig.json",
    "include": [".astro/types.d.ts", "content/**/*.solid.tsx", "src/components/landing/**/*.solid.tsx"],
    "exclude": ["dist"],
    "compilerOptions": {
        "jsx": "preserve",
        "jsxImportSource": "solid-js",
        "noEmit": true,
        "noUnusedLocals": true,
        "strict": true,
        "strictNullChecks": true
    }
}

{
    "name": "semi-design-next",
    "version": "0.0.1",
    "description": "Semi Design Next monorepo",
    "private": true,
    "type": "module",
    "scripts": {
        "prepare": "vp config --no-agent",
        "lint": "pnpm run lint:scopes && pnpm run lint:script && pnpm run lint:private && pnpm run lint:class-order && pnpm run lint:component-order && pnpm run lint:scss-variables && pnpm run lint:style && pnpm run lint:mdx-tables && pnpm run lint:react && pnpm run lint:svelte",
        "lint:scopes": "node scripts/lint-scopes.ts",
        "lint:script": "vp lint --deny-warnings && pnpm lint:vue && pnpm lint:svelte-template",
        "lint:vue": "eslint '**/*.vue' --max-warnings 0",
        "lint:svelte-template": "eslint '**/*.svelte' --max-warnings 0",
        "lint:svelte": "pnpm --filter './packages/semi-*-svelte' --no-bail exec svelte-check --fail-on-warnings",
        "lint:private": "node scripts/lint-private.ts",
        "lint:class-order": "node scripts/lint-class-order.ts",
        "lint:component-order": "node scripts/lint-component-order.ts",
        "lint:scss-variables": "node scripts/lint-scss-variables.ts",
        "lint:style": "stylelint '**/*.{scss,css,astro}' --max-warnings 0",
        "lint:react": "node website/scripts/compiler-check.ts",
        "lint:mdx-tables": "node website/scripts/lint-mdx-tables.ts",
        "lint:fix": "vp lint --fix && eslint '**/*.{vue,svelte}' --fix --max-warnings 0 && stylelint '**/*.{scss,css,astro}' --fix",
        "format": "vp fmt",
        "format:check": "vp fmt --check",
        "typecheck": "node scripts/typecheck.ts",
        "test": "vp test run --project '!*-browser' --silent=true",
        "test:packed": "node vitest/packed/run.ts",
        "test:hosts": "node vitest/hosts/run.ts",
        "test:browser": "vp test run --project '*-browser'",
        "test:coverage": "vp test run --silent --coverage --testTimeout=15000 --project '!*-ssr' --project '!*-hydration-browser'",
        "test:ssr": "vp test run --silent --project '*-ssr' --project '*-hydration-browser'",
        "test:plugins": "vp run --filter './packages/*' test",
        "check": "pnpm lint && pnpm format:check && vp test run --silent",
        "check:full": "pnpm build &&pnpm typecheck && pnpm lint && pnpm format:check && pnpm --filter semi-website gen:react-api --check && pnpm --filter semi-website gen:vue-api --check && pnpm --filter semi-website gen:solid-api --check && pnpm --filter semi-website gen:svelte-api --check && pnpm test:coverage && pnpm test:ssr && pnpm test:packed && pnpm test:plugins",
        "build": "vp run --filter './packages/*' build",
        "build:icon": "vp run -r --concurrency-limit 1 build:icon",
        "site:dev": "pnpm --filter semi-website exec astro dev --port 4321 --host 127.0.0.1",
        "site:build": "pnpm --filter semi-website build",
        "site:preview": "pnpm --filter semi-website exec astro preview --port 4322 --host 127.0.0.1",
        "site:serve": "pnpm site:build && pnpm site:preview",
        "site:stop": "pnpm --filter semi-website exec astro dev stop && pnpm --filter semi-website exec astro preview stop"
    },
    "engines": {
        "node": ">=26.10.0"
    },
    "devDependencies": {
        "@changesets/cli": "catalog:",
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@solidjs/testing-library": "^0.8.10",
        "@sveltejs/vite-plugin-svelte": "catalog:",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "catalog:",
        "@testing-library/svelte": "catalog:",
        "@testing-library/user-event": "^14.6.8",
        "@testing-library/vue": "^8.1.0",
        "@types/node": "^26.6.5",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@typescript-eslint/parser": "^8.72.0",
        "@vitejs/plugin-vue": "catalog:",
        "@vitest/browser-playwright": "5.0.5",
        "@vitest/coverage-istanbul": "5.0.5",
        "es-toolkit": "catalog:",
        "eslint": "^10.13.0",
        "eslint-plugin-oxlint": "1.89.0",
        "eslint-plugin-perfectionist": "^5.13.0",
        "eslint-plugin-solid": "0.18.1",
        "eslint-plugin-svelte": "catalog:",
        "eslint-plugin-vue": "^10.11.1",
        "eslint-plugin-vuejs-accessibility": "^2.6.3",
        "jiti": "^2.7.0",
        "jsdom": "catalog:",
        "oxfmt": "0.74.0",
        "oxlint": "1.89.0",
        "playwright": "catalog:",
        "postcss-html": "^2.0.0",
        "postcss-scss": "^4.0.9",
        "react": "catalog:",
        "react-dom": "catalog:",
        "sass": "catalog:",
        "sass-embedded": "catalog:",
        "solid-js": "catalog:",
        "stylelint": "^17.16.0",
        "stylelint-config-recess-order": "^7.9.0",
        "stylelint-order": "^8.1.2",
        "stylelint-scss": "^7.3.0",
        "svelte": "catalog:",
        "svelte-check": "catalog:",
        "svelte-eslint-parser": "catalog:",
        "svgo": "^4.1.0",
        "typescript": "catalog:",
        "unplugin-solid": "catalog:",
        "vite": "catalog:",
        "vite-plus": "1.4.0",
        "vitest": "5.0.5",
        "vue": "catalog:",
        "vue-tsc": "catalog:"
    },
    "packageManager": "pnpm@12.9.1"
}

{
    "name": "semi-design-next",
    "version": "0.0.1",
    "description": "Semi Design Next monorepo",
    "private": true,
    "type": "module",
    "scripts": {
        "prepare": "vp config --no-agent",
        "lint": "pnpm run lint:rules && pnpm run lint:code && pnpm run lint:style && pnpm run lint:docs && pnpm run lint:react && pnpm run lint:vue && pnpm run lint:svelte",
        "lint:rules": "pnpm run lint:scopes && pnpm run lint:private && pnpm run lint:layers && pnpm run lint:class-order && pnpm run lint:component-order && pnpm run lint:scss-variables && pnpm run lint:click-outside",
        "lint:code": "vp lint --deny-warnings",
        "lint:docs": "vp run semi-website#lint:mdx",
        "lint:react": "node website/scripts/lint-compiler.react.ts",
        "lint:vue": "eslint --config eslint.config.ts '**/*.vue' --max-warnings 0 && node scripts/lint-templates.vue.ts",
        "lint:svelte": "eslint --config eslint.config.ts '**/*.svelte' --max-warnings 0 && vp run --parallel --filter './packages/semi-*-svelte' check",
        "lint:scopes": "node scripts/lint-scopes.ts",
        "lint:private": "node scripts/lint-private.ts",
        "lint:layers": "node scripts/lint-layers.ts",
        "lint:class-order": "node scripts/lint-class-order.ts",
        "lint:component-order": "node scripts/lint-component-order.ts",
        "lint:scss-variables": "node scripts/lint-scss-variables.ts",
        "lint:click-outside": "node scripts/lint-click-outside.ts",
        "lint:style": "stylelint --config stylelint.config.ts '**/*.{scss,css,astro}' '!tmp/**' --max-warnings 0",
        "lint:fix": "vp lint --fix && eslint --config eslint.config.ts '**/*.{vue,svelte}' --fix --max-warnings 0 && stylelint --config stylelint.config.ts '**/*.{scss,css,astro}' --fix",
        "format": "vp fmt",
        "format:check": "vp fmt --check",
        "changeset:version": "changeset version && vp fmt",
        "typecheck": "node scripts/typecheck.ts && pnpm --filter semi-website check",
        "test": "vp test run --project '!*-browser' --silent=true",
        "test:packed": "node vitest/packed/run.ts",
        "size": "node scripts/size.ts",
        "test:hosts": "node vitest/hosts/run.ts",
        "test:browser": "VITEST_CHROMIUM_GC_FORCE=1 VITEST_CHROMIUM_GC_DISK_THRESHOLD_GB=1000000 vp test run --project '*-browser'",
        "test:coverage": "VITEST_CHROMIUM_GC_FORCE=1 VITEST_CHROMIUM_GC_DISK_THRESHOLD_GB=1000000 vp test run --silent --coverage --testTimeout=15000 --project '!*-ssr' --project '!*-hydration-browser'",
        "test:ssr": "VITEST_CHROMIUM_GC_FORCE=1 VITEST_CHROMIUM_GC_DISK_THRESHOLD_GB=1000000 vp test run --silent --project '*-ssr' --project '*-hydration-browser'",
        "test:plugins": "vp run --filter './packages/**' test",
        "check:changed": "node scripts/check-changed.ts",
        "check": "pnpm lint && pnpm format:check && pnpm test",
        "check:full": "pnpm build && pnpm typecheck && pnpm lint && pnpm format:check && pnpm --filter semi-website gen:api:check && pnpm test:coverage && pnpm test:ssr && pnpm test:packed && pnpm size && pnpm test:plugins",
        "build": "vp run --filter './packages/**' build && pnpm build:agent-docs",
        "build:agent-docs": "node website/scripts/agent-docs.ts && node website/scripts/dts-jsdoc.ts",
        "build:icon": "vp run -r --concurrency-limit 1 build:icon",
        "site:dev": "pnpm --filter semi-website dev",
        "site:build": "pnpm --filter semi-website build",
        "site:preview": "pnpm --filter semi-website preview",
        "site:serve": "pnpm site:build && pnpm site:preview",
        "site:stop": "pnpm --filter semi-website stop"
    },
    "engines": {
        "node": ">=26.10.0"
    },
    "devDependencies": {
        "@changesets/cli": "catalog:",
        "@commitlint/cli": "^21.2.4",
        "@commitlint/config-conventional": "^21.2.4",
        "@solidjs/testing-library": "^0.8.10",
        "@sveltejs/vite-plugin-svelte": "catalog:",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "catalog:",
        "@testing-library/svelte": "catalog:",
        "@testing-library/user-event": "^14.6.12",
        "@testing-library/vue": "^8.1.0",
        "@types/node": "^26.6.6",
        "@types/react": "catalog:",
        "@types/react-dom": "catalog:",
        "@typescript-eslint/parser": "^8.73.0",
        "@vitejs/plugin-vue": "catalog:",
        "@vitest/browser-playwright": "5.1.0",
        "@vitest/coverage-istanbul": "5.1.0",
        "es-toolkit": "catalog:",
        "eslint": "^10.15.0",
        "eslint-plugin-oxlint": "1.94.0",
        "eslint-plugin-perfectionist": "^5.14.0",
        "eslint-plugin-solid": "0.19.0",
        "eslint-plugin-svelte": "catalog:",
        "eslint-plugin-vue": "^10.12.1",
        "eslint-plugin-vuejs-accessibility": "^2.6.3",
        "jiti": "^2.7.0",
        "jsdom": "catalog:",
        "oxfmt": "0.79.0",
        "oxlint": "1.94.0",
        "playwright": "catalog:",
        "postcss-html": "^2.0.1",
        "postcss-scss": "^4.0.9",
        "react": "catalog:",
        "react-dom": "catalog:",
        "sass": "catalog:",
        "sass-embedded": "catalog:",
        "solid-js": "catalog:",
        "stylelint": "^18.0.0",
        "stylelint-config-recess-order": "^7.10.1",
        "stylelint-order": "^8.1.3",
        "stylelint-scss": "^7.5.0",
        "svelte": "catalog:",
        "svelte-check": "catalog:",
        "svelte-eslint-parser": "catalog:",
        "svgo": "^4.1.0",
        "typescript": "catalog:",
        "unplugin-solid": "catalog:",
        "vite": "catalog:",
        "vite-plus": "1.7.0",
        "vitest": "5.1.0",
        "vue": "catalog:",
        "vue-tsc": "catalog:",
        "zod": "catalog:"
    },
    "packageManager": "pnpm@12.9.1"
}

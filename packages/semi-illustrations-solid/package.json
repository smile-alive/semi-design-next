{
    "name": "@fibrae/semi-illustrations-solid",
    "version": "0.1.1",
    "description": "Semi illustrations as Solid components",
    "license": "MIT",
    "homepage": "https://semi-design-next.pages.dev",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/smile-alive/semi-design-next.git",
        "directory": "packages/semi-illustrations-solid"
    },
    "bugs": {
        "url": "https://github.com/smile-alive/semi-design-next/issues"
    },
    "keywords": [
        "semi",
        "illustrations"
    ],
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "solid": "./dist/index.jsx",
            "default": "./dist/index.js"
        },
        "./package.json": "./package.json",
        "./*": {
            "types": "./dist/*.d.ts",
            "solid": "./dist/*.jsx",
            "default": "./dist/*.js"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": false,
    "scripts": {
        "build:icon": "node scripts/build-illustration.ts",
        "build": "vp pack"
    },
    "dependencies": {
        "@fibrae/semi-icons-core": "workspace:*",
        "@fibrae/semi-icons-solid": "workspace:*"
    },
    "devDependencies": {
        "solid-js": "catalog:",
        "typescript": "catalog:"
    },
    "peerDependencies": {
        "solid-js": "catalog:peer"
    }
}

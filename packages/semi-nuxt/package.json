{
    "name": "@fibrae/semi-nuxt",
    "version": "0.1.0",
    "description": "Nuxt module that supports Semi Design Next in Nuxt",
    "license": "MIT",
    "homepage": "https://semi-design-next.pages.dev",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/smile-alive/semi-design-next.git",
        "directory": "packages/semi-nuxt"
    },

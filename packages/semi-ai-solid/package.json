{
    "name": "@fibrae/semi-ai-solid",
    "version": "0.1.0",
    "description": "Semi AI components for Solid: AIChatInput, AIChatDialogue, Chat and Sidebar.",
    "license": "MIT",
    "homepage": "https://semi-design-next.pages.dev",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/smile-alive/semi-design-next.git",
        "directory": "packages/semi-ai-solid"
    },
    "bugs": {
        "url": "https://github.com/smile-alive/semi-design-next/issues"
    },
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "solid": "./dist/index.jsx",
            "default": "./dist/index.js"
        },
        "./styles.css": "./dist/styles.css",
        "./package.json": "./package.json",
        "./*": {
            "types": "./dist/*.d.ts",
            "solid": "./dist/*.jsx",
            "default": "./dist/*.js"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": [
        "*.scss",
        "*.css"
    ],
    "scripts": {
        "build": "vp pack"
    },
    "dependencies": {
        "@fibrae/semi-ai-foundation": "workspace:*",
        "@fibrae/semi-foundation": "workspace:*",
        "@fibrae/semi-icons-solid": "workspace:*",
        "@fibrae/semi-illustrations-solid": "workspace:*",
        "@fibrae/semi-ui-solid": "workspace:*",
        "@tiptap/core": "catalog:",
        "@tiptap/pm": "catalog:",
        "clsx": "catalog:",
        "es-toolkit": "catalog:"
    },
    "peerDependencies": {
        "solid-js": "catalog:peer"
    },
    "devDependencies": {
        "solid-js": "catalog:",
        "typescript": "catalog:",
        "unplugin-solid": "catalog:"
    }
}

{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "outDir": "dist",
        "sourceMap": true,
        "rootDir": "src",
        "declaration": true,
        "strict": true,
        "strictNullChecks": true,
        "erasableSyntaxOnly": true,
        // The Solid compiler reads JSX itself; tsc only type-checks it against solid-js's JSX namespace
        "jsx": "preserve",
        "jsxImportSource": "solid-js",
        "types": []
    },
    "include": ["src/**/*.ts", "src/**/*.tsx"],
    "exclude": ["src/**/__tests__/**"]
}

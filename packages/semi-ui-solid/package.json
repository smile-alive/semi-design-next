{
    "name": "@fibrae/semi-ui-solid",
    "version": "0.1.1",
    "description": "Semi Design Next Solid components",
    "license": "MIT",
    "homepage": "https://semi-design-next.pages.dev",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/smile-alive/semi-design-next.git",
        "directory": "packages/semi-ui-solid"
    },
    "bugs": {
        "url": "https://github.com/smile-alive/semi-design-next/issues"
    },
    "type": "module",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "solid": "./dist/index.jsx",
            "default": "./dist/index.js"
        },
        "./styles.css": "./dist/styles.css",
        "./tailwind.css": "./dist/tailwind.css",
        "./package.json": "./package.json",
        "./*": {
            "types": "./dist/*.d.ts",
            "solid": "./dist/*.jsx",
            "default": "./dist/*.js"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": [
        "*.scss",
        "*.css",
        "./dist/tokens.js",
        "./dist/tokens.jsx",
        "./src/tokens.ts"
    ],
    "scripts": {
        "build": "vp pack"
    },
    "dependencies": {
        "@dnd-kit/solid": "catalog:",
        "@fibrae/semi-foundation": "workspace:*",
        "@fibrae/semi-icons-solid": "workspace:*",
        "@tanstack/solid-virtual": "catalog:",
        "clsx": "catalog:",
        "date-fns": "catalog:",
        "es-toolkit": "catalog:"
    },
    "peerDependencies": {
        "solid-js": "catalog:peer"
    },
    "devDependencies": {
        "solid-js": "catalog:",
        "typescript": "catalog:",
        "unplugin-solid": "catalog:"
    }
}

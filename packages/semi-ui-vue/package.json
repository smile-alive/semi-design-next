{
    "name": "@fibrae/semi-ui-vue",
    "version": "0.1.1",
    "description": "Semi Design Next Vue components",
    "license": "MIT",
    "homepage": "https://semi-design-next.pages.dev",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/smile-alive/semi-design-next.git",
        "directory": "packages/semi-ui-vue"
    },
    "bugs": {
        "url": "https://github.com/smile-alive/semi-design-next/issues"
    },
    "type": "module",
    "exports": {
        ".": "./dist/index.js",
        "./styles.css": "./dist/styles.css",

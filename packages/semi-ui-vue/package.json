    ],
    "sideEffects": [
        "*.scss",
        "*.css",
        "./dist/tokens.js",
        "./src/tokens.ts"
    ],
    "scripts": {
        "build": "vp pack",
        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "@dnd-kit/vue": "catalog:",
        "@fibrae/semi-foundation": "workspace:*",
        "@fibrae/semi-icons-vue": "workspace:*",
        "@tanstack/vue-virtual": "catalog:",
        "async-validator": "catalog:",
        "date-fns": "catalog:",
        "es-toolkit": "catalog:",
        "scroll-into-view-if-needed": "catalog:",
        "unified": "catalog:"
    },
    "peerDependencies": {
        "vue": "catalog:peer"
    },
    "devDependencies": {
        "@vitejs/plugin-vue": "catalog:",
        "typescript": "catalog:",
        "vue": "catalog:",
        "vue-tsc": "catalog:"
    }
}

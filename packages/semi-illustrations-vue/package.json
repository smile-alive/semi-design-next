{
    "name": "@fibrae/semi-illustrations-vue",
    "version": "0.2.0",
    "description": "Semi illustrations as Vue components",
    "license": "MIT",
    "homepage": "https://semi-design-next.pages.dev",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/smile-alive/semi-design-next.git",
        "directory": "packages/semi-illustrations-vue"
    },
    "bugs": {
        "url": "https://github.com/smile-alive/semi-design-next/issues"
    },
    "type": "module",
    "exports": {
        ".": "./dist/index.js",
        "./package.json": "./package.json",
        "./*": "./dist/*.js"
    },
    "files": [

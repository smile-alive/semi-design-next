        "prepublishOnly": "npm run build"
    },
    "dependencies": {
        "@fibrae/semi-icons-core": "workspace:*",
        "@fibrae/semi-icons-vue": "workspace:*"
    },
    "devDependencies": {
        "typescript": "catalog:",
        "vue": "catalog:",
        "vue-tsc": "catalog:"
    },
    "peerDependencies": {
        "vue": "catalog:peer"
    }
}

{
    "name": "@fibrae/semi-icons-svelte",
    "version": "0.2.0",
    "description": "Semi icons as Svelte components",
    "license": "MIT",
    "homepage": "https://semi-design-next.pages.dev",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/smile-alive/semi-design-next.git",
        "directory": "packages/semi-icons-svelte"
    },
    "bugs": {
        "url": "https://github.com/smile-alive/semi-design-next/issues"
    },
    "type": "module",
    "svelte": "./dist/index.js",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "svelte": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./lab": {
            "types": "./dist/lab/index.d.ts",
            "svelte": "./dist/lab/index.js",
            "default": "./dist/lab/index.js"
        },
        "./package.json": "./package.json",
        "./*.svelte": {
            "types": "./dist/*.svelte.d.ts",
            "svelte": "./dist/*.svelte",
            "default": "./dist/*.svelte"
        },
        "./*": {
            "types": "./dist/*.d.ts",
            "svelte": "./dist/*.js",
            "default": "./dist/*.js"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": [
        "*.scss",
        "*.css"
    ],
    "scripts": {
        "build:icon": "node scripts/build-icon.ts",
        "build": "node ../../scripts/svelte-package.ts"
    },
    "dependencies": {
        "@fibrae/semi-icons-core": "workspace:*"
    },
    "peerDependencies": {
        "svelte": "catalog:peer"
    },
    "devDependencies": {
        "@sveltejs/package": "catalog:",
        "@sveltejs/vite-plugin-svelte": "catalog:",
        "@testing-library/svelte": "catalog:",
        "svelte": "catalog:",
        "svelte-check": "catalog:",
        "typescript": "catalog:"
    }
}

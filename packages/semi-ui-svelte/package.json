{
    "name": "@fibrae/semi-ui-svelte",
    "version": "0.3.1",
    "description": "Semi Design Next Svelte components",
    "license": "MIT",
    "homepage": "https://semi-design-next.pages.dev",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/smile-alive/semi-design-next.git",
        "directory": "packages/semi-ui-svelte"
    },
    "bugs": {
        "url": "https://github.com/smile-alive/semi-design-next/issues"
    },
    "type": "module",
    "svelte": "./dist/index.js",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "svelte": "./dist/index.js",
            "default": "./dist/index.js"
        },
        "./styles.css": "./dist/styles.css",
        "./tailwind.css": "./dist/tailwind.css",
        "./package.json": "./package.json",
        "./hooks": {
            "types": "./dist/hooks.d.ts",
            "svelte": "./dist/hooks.js",
            "default": "./dist/hooks.js"
        },
        "./tokens": {
            "types": "./dist/tokens.d.ts",
            "svelte": "./dist/tokens.js",
            "default": "./dist/tokens.js"
        },
        "./base/*.svelte": {
            "types": "./dist/base/*.svelte.d.ts",
            "svelte": "./dist/base/*.svelte",
            "default": "./dist/base/*.svelte"
        },
        "./base/*.svelte.js": {
            "types": "./dist/base/*.svelte.d.ts",
            "svelte": "./dist/base/*.svelte.js",
            "default": "./dist/base/*.svelte.js"
        },
        "./base/*": {
            "types": "./dist/base/*.d.ts",
            "svelte": "./dist/base/*.js",
            "default": "./dist/base/*.js"
        },
        "./hooks/*.svelte.js": {
            "types": "./dist/hooks/*.svelte.d.ts",
            "svelte": "./dist/hooks/*.svelte.js",
            "default": "./dist/hooks/*.svelte.js"
        },
        "./hooks/*": {
            "types": "./dist/hooks/*.d.ts",
            "svelte": "./dist/hooks/*.js",
            "default": "./dist/hooks/*.js"
        },
        "./internal/*.svelte": {
            "types": "./dist/internal/*.svelte.d.ts",
            "svelte": "./dist/internal/*.svelte",
            "default": "./dist/internal/*.svelte"
        },
        "./internal/*": {
            "types": "./dist/internal/*.d.ts",
            "svelte": "./dist/internal/*.js",
            "default": "./dist/internal/*.js"
        },
        "./utils/*": {
            "types": "./dist/utils/*.d.ts",
            "svelte": "./dist/utils/*.js",
            "default": "./dist/utils/*.js"
        },
        "./*.svelte": {
            "types": "./dist/components/*.svelte.d.ts",
            "svelte": "./dist/components/*.svelte",
            "default": "./dist/components/*.svelte"
        },
        "./*.svelte.js": {
            "types": "./dist/components/*.svelte.d.ts",
            "svelte": "./dist/components/*.svelte.js",
            "default": "./dist/components/*.svelte.js"
        },
        "./*": {
            "types": "./dist/components/*.d.ts",
            "svelte": "./dist/components/*.js",
            "default": "./dist/components/*.js"
        }
    },
    "files": [
        "dist"
    ],
    "sideEffects": [
        "*.scss",
        "*.css",
        "*.svelte",
        "./dist/tokens.js",
        "./src/tokens.ts"
    ],
    "scripts": {
        "build": "node ../../scripts/svelte-package.ts --bundles ui --locale"
    },
    "dependencies": {
        "@dnd-kit/dom": "catalog:",
        "@dnd-kit/svelte": "catalog:",
        "@fibrae/semi-foundation": "workspace:*",
        "@fibrae/semi-icons-svelte": "workspace:*",
        "@tanstack/svelte-virtual": "catalog:",
        "date-fns": "catalog:",
        "es-toolkit": "catalog:",
        "scroll-into-view-if-needed": "catalog:",
        "unified": "catalog:"
    },
    "peerDependencies": {
        "svelte": "catalog:peer"
    },
    "devDependencies": {
        "@sveltejs/package": "catalog:",
        "@sveltejs/vite-plugin-svelte": "catalog:",
        "@testing-library/svelte": "catalog:",
        "eslint-plugin-svelte": "catalog:",
        "svelte": "catalog:",
        "svelte-check": "catalog:",
        "typescript": "catalog:"
    }
}

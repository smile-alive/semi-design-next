    },
    "devDependencies": {
        "@vitejs/plugin-vue": "catalog:",
        "typescript": "catalog:",
        "vue": "catalog:",
        "vue-tsc": "catalog:"
    },
    "peerDependencies": {
        "vue": "catalog:peer"
    }
}

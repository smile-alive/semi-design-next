{
    "name": "@fibrae/semi-icons-vue",
    "version": "0.1.1",
    "description": "Semi icons as Vue components",
    "license": "MIT",
    "homepage": "https://semi-design-next.pages.dev",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/smile-alive/semi-design-next.git",
        "directory": "packages/semi-icons-vue"
    },
    "bugs": {
        "url": "https://github.com/smile-alive/semi-design-next/issues"
    },
    "type": "module",
    "exports": {
        ".": "./dist/index.js",
        "./lab": "./dist/lab/index.js",
        "./package.json": "./package.json",
        "./*": "./dist/*.js"
    },
    "files": [

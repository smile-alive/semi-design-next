{
    "extends": "../../tsconfig.base.json",
    "compilerOptions": {
        "outDir": "dist",
        "rootDir": "src",
        "declaration": true,
        "strict": true,
        "strictNullChecks": true,
        "erasableSyntaxOnly": true,
        "jsx": "preserve",
        "jsxImportSource": "vue",
        "types": []
    },
    "vueCompilerOptions": { "fallthroughAttributes": true },
    "include": ["src/**/*.ts", "src/**/*.vue"],
    "exclude": ["node_modules", "dist", "**/__tests__/**"]
}
